# Postgres-only (required):
DATABASE_URL=postgresql+psycopg2://graphrag:graphrag_dev_only@localhost:5432/graphrag
EMBEDDER=minilm           # local all-MiniLM-L6-v2, 384-d, no API key
EMBED_DIM=384             # must match chunks.embedding vector(N) + MiniLM dim

SEC_USER_AGENT="prakash.mahatra18@gmail.com"

# Retrieval fusion weights
LEXICAL_WEIGHT=1.0
VECTOR_WEIGHT=1.0

# Embedding token budget (WordPiece; shared by chunker + embedder)
EMBED_TOKENIZER=sentence-transformers/all-MiniLM-L6-v2

# Cross-encoder reranker (on by default; falls back to RRF order if it
# can't load -- e.g. offline with no HF cache)
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_POOL=40

# Optional LLM answer synthesis (structured JSON: summary + key points +
# citation ids). Get a free key at https://aistudio.google.com/apikey
# Empty = deterministic evidence answers (works with no key at all).
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional local generation layer (off by default -- system works without it)
USE_OLLAMA=false
OLLAMA_MODEL=llama3.1
OLLAMA_URL=http://localhost:11434/api/generate
